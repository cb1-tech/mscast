erpnext-poc/backups/
*.sql
*.sql.gz
*.tar
*.tar.gz

# transient exports
erpnext-poc/*.json
erpnext-poc/seed/_archive/

# local noise
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
~$*
*.tmp

# working scratch, not part of the deliverable
Claude outputs/
staging-build.log
erpnext-poc/backups/
